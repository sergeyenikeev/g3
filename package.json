{
  "name": "magnet-caravan",
  "private": true,
  "version": "0.1.0",
  "description": "Magnet Caravan (Phaser 3 + TypeScript + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "node scripts/build_platform_release.mjs web",
    "build:generic": "node scripts/build_platform_release.mjs generic",
    "build:yandex": "node scripts/build_platform_release.mjs yandex",
    "build:vk": "node scripts/build_platform_release.mjs vk",
    "preview": "vite preview --strictPort --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "bom-check": "node scripts/check_bom.mjs",
    "fix-bom": "node scripts/fix_bom.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "node scripts/run_playwright_e2e.mjs",
    "audio:generate": "node scripts/generate_audio_assets.mjs",
    "visual:generate": "node scripts/generate_visual_assets.mjs",
    "media:yandex": "node scripts/capture_yandex_media.mjs",
    "audit:ui": "node scripts/capture_ui_audit_matrix.mjs",
    "audit:yandex": "node scripts/run_yandex_publish_smoke.mjs",
    "handoff:yandex": "node scripts/build_yandex_handoff.mjs",
    "package:yandex": "node scripts/assemble_yandex_upload.mjs",
    "build:test-mock": "node scripts/build_test_mock.mjs",
    "build:release": "node scripts/build_release.mjs"
  },
  "dependencies": {
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.7",
    "archiver": "^7.0.1",
    "eslint": "^9.17.0",
    "ffmpeg-static": "^5.2.0",
    "iconv-lite": "^0.6.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
